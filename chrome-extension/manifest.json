{
  "manifest_version": 3,
  "name": "STUDY_SYNC - Quick Task Creator",
  "version": "1.0.0",
  "description": "Quickly create and manage tasks from anywhere on the web",
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://study-sync-mv99.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Quick Task Creator",
    "default_icons": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  }
}
